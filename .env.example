APEX_ENV=development
APEX_DATABASE_URL=sqlite:///./data/apex.db
APEX_SECRET_KEY=
APEX_ACCESS_TOKEN_MINUTES=15
APEX_REFRESH_TOKEN_DAYS=30
APEX_CORS_ORIGINS=http://localhost:3000
# Local-only convenience. Production must set this to false.
APEX_EXPOSE_DEVELOPMENT_TOKENS=true
NEXT_PUBLIC_APEX_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production infrastructure placeholders
POSTGRES_USER=apex
POSTGRES_PASSWORD=
POSTGRES_DB=apex
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
EMAIL_PROVIDER_API_KEY=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
PAYMENT_PROVIDER_SECRET=
OTEL_EXPORTER_OTLP_ENDPOINT=
EXTERNAL_MODEL_PROVIDER_KEY=
MCP_ENCRYPTION_KEY=
